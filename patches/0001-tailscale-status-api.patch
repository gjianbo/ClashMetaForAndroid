+// backendState 读一次当前后端状态，供看门狗判断是否需要重建。
+func (t *Tailscale) backendState() (string, error) {
+	srv := t.currentServer()
+	if srv == nil || !t.started() {
+		return "", errors.New("tailscale not started")
+	}
+	lc, err := srv.LocalClient()
+	if err != nil {
+		return "", err
+	}
+	ctx, cancel := context.WithTimeout(t.ctx, tailscaleStatusTimeout)
+	defer cancel()
+	st, err := lc.Status(ctx)
+	if err != nil {
+		return "", err
+	}
+	return st.BackendState, nil
+}
