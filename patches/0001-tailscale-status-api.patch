+// LookupTailscale returns a live Tailscale outbound instance, if any.
+// It lets the client query tsnet status without depending on how mihomo
+// wraps adapters internally.
+func LookupTailscale() *Tailscale {
+	var found *Tailscale
+
+	tailscaleRegistry.Range(func(_, value any) bool {
+		if ts, ok := value.(*Tailscale); ok {
+			found = ts
+
+			return false
+		}
+
+		return true
+	})
+
+	return found
+}
