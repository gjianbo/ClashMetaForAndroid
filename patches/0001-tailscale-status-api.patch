+// startWatchdog 巡检后端健康度：连续多个周期非 Running（且不是等待登录）就重建实例。
+// 这是解决「换网/换节点后必须手动点一下才恢复」的核心：以前没有任何人负责拉起。
+func (t *Tailscale) startWatchdog() {
+	t.watchdogOnce.Do(func() {
+		go func() {
+			ticker := time.NewTicker(tailscaleWatchdogInterval)
+			defer ticker.Stop()
+
+			badTicks := 0
+			var backoff time.Duration
+			var cooldownUntil time.Time
+			needLoginWarned := false
+
+			for {
+				select {
+				case <-t.ctx.Done():
+					return
+				case <-ticker.C:
+				}
+
+				state, err := t.backendState()
+				parsed, known := ipn.StateFromString(state)
+
+				if err == nil && known && parsed == ipn.Running {
+					badTicks = 0
+					backoff = 0
+					needLoginWarned = false
+					t.retryPrefsIfNeeded()
+					continue
+				}
+
+				if err == nil && known && parsed == ipn.NeedsLogin {
+					if !needLoginWarned {
+						log.Warnln("[Tailscale](%s) needs login, waiting for authorization", t.option.Name)
+						needLoginWarned = true
+					}
+					badTicks = 0
+					continue
+				}
+
+				badTicks++
+
+				if badTicks < tailscaleWatchdogThreshold {
+					continue
+				}
+				if time.Now().Before(cooldownUntil) {
+					continue
+				}
+
+				reason := fmt.Sprintf("backend state %q", state)
+				if err != nil {
+					reason = err.Error()
+				}
+				if rerr := t.restart(reason); rerr != nil {
+					log.Warnln("[Tailscale](%s) rebuild failed, will retry: %v", t.option.Name, rerr)
+				}
+
+				if backoff == 0 {
+					backoff = tailscaleWatchdogMinBackoff
+				} else if backoff *= 2; backoff > tailscaleWatchdogMaxBackoff {
+					backoff = tailscaleWatchdogMaxBackoff
+				}
+				cooldownUntil = time.Now().Add(backoff)
+				badTicks = 0
+			}
+		}()
+	})
+}
